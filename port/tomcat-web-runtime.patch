+#ifdef __EMSCRIPTEN__
+	void EditorLayer::WebInitializeDemoScene()
+	{
+		// Seed the editor with the same small scene used by the Web runtime.  The
+		// scene remains an ordinary upstream Scene, so all hierarchy, inspector,
+		// gizmo and serialization code follows the desktop path afterwards.
+		auto scene = CreateRef<Scene>();
+		const uint32_t width = m_ViewportSize.x > 0.0f ? (uint32_t)m_ViewportSize.x : 1280u;
+		const uint32_t height = m_ViewportSize.y > 0.0f ? (uint32_t)m_ViewportSize.y : 720u;
+		scene->OnViewportResize(width, height);
+
+		Entity camera = scene->CreateEntity("Main Camera");
+		camera.GetComponent<Transform>()._Translation = glm::vec3(0.0f, 0.0f, 0.0f);
+		auto& cameraComponent = camera.AddComponent<C_Camera>();
+		cameraComponent._Camera.SetOrthographic(5.0f, -1.0f, 1.0f);
+		cameraComponent._Camera.SetViewportSize(width, height);
+		cameraComponent.Primary = true;
+
+		Entity ground = scene->CreateEntity("Ground");
+		ground.GetComponent<Transform>()._Translation = glm::vec3(0.0f, -2.0f, 0.0f);
+		ground.GetComponent<Transform>()._Scale = glm::vec3(8.0f, 1.0f, 1.0f);
+		ground.AddComponent<SpriteRenderer>(glm::vec4(0.25f, 0.35f, 0.45f, 1.0f));
+		ground.AddComponent<Rigidbody2D>();
+		auto& groundCollider = ground.AddComponent<BoxCollider2D>();
+		groundCollider.Size = glm::vec2(4.0f, 0.5f);
+
+		Entity player = scene->CreateEntity("Player");
+		player.GetComponent<Transform>()._Translation = glm::vec3(0.0f, 0.0f, 0.0f);
+		player.GetComponent<Transform>()._Scale = glm::vec3(0.5f, 0.5f, 1.0f);
+		player.AddComponent<SpriteRenderer>(glm::vec4(0.95f, 0.55f, 0.25f, 1.0f));
+		auto& rigidbody = player.AddComponent<Rigidbody2D>();
+		rigidbody.Type = Rigidbody2D::BodyType::Dynamic;
+		rigidbody.FixedRotation = true;
+		auto& boxCollider = player.AddComponent<BoxCollider2D>();
+		boxCollider.Size = glm::vec2(0.25f, 0.25f);
+
+		m_EditorScene = scene;
+		m_ActiveScene = scene;
+		m_SceneState = SceneState::Edit;
+		m_EditorScenePath.clear();
+		m_CurrentScenePath.clear();
+		m_SceneDirty = true;
+		m_SceneHierarchyPanel.SetContext(scene, true);
+		m_ContentBrowserPanel.SetProject(m_CurrentProject);
+	}
+
+	bool EditorLayer::WebLoadScene(const std::filesystem::path& path)
+	{
+		if (path.empty() || path.extension() != ".tomcat")
+			return false;
+		OpenScene(path);
+		return m_EditorScene && m_EditorScenePath == path;
+	}
+
+	bool EditorLayer::WebSaveScene(const std::filesystem::path& path)
+	{
+		if (path.empty() || !m_ActiveScene)
+			return false;
+		SerializeScene(m_EditorScene ? m_EditorScene : m_ActiveScene, path);
+		m_EditorScenePath = path;
+		m_CurrentScenePath = path;
+		m_SceneDirty = false;
+		return true;
+	}
+
+	void EditorLayer::WebSetProject(Ref<Project> project)
+	{
+		m_CurrentProject = project;
+		ProjectManager::Get().SetActiveProject(project);
+		m_ContentBrowserPanel.SetProject(project);
+	}
+
+	void EditorLayer::WebPlay()
+	{
+		if (m_SceneState == SceneState::Edit && m_EditorScene)
+			OnScenePlay();
+	}
+
+	void EditorLayer::WebStop()
+	{
+		if (m_SceneState == SceneState::Play)
+			OnSceneStop();
+	}
+#endif
+}
