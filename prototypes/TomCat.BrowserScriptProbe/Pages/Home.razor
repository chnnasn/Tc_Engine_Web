@page "/"
@using System.Reflection
@using TomCat.ScriptHost

<PageTitle>TomCat C# 浏览器兼容性验证</PageTitle>

<h1>TomCat C# 浏览器兼容性验证</h1>

<p>该页面在浏览器的 .NET WebAssembly 运行时内加载 TomCat 的托管脚本宿主。</p>

<dl>
    @foreach (ProbeResult result in _results)
    {
        <dt>@result.Name</dt>
        <dd class="@(result.Passed ? "pass" : "fail")">@(result.Passed ? "通过" : "失败")：@result.Detail</dd>
    }
</dl>

@if (_running)
{
    <p>正在执行验证……</p>
}
else
{
    <p id="probe-summary" data-passed="@_passed.ToString().ToLowerInvariant()">
        结论：@(_passed ? "现有托管宿主可以进入下一阶段的原生 ABI 联调。" : "现有托管宿主不能原样用于浏览器，需要浏览器专用脚本域实现。")
    </p>
}

@code {
    private readonly List<ProbeResult> _results = [];
    private bool _running = true;
    private bool _passed;

    protected override Task OnInitializedAsync()
    {
        RunProbe();
        return Task.CompletedTask;
    }

    private void RunProbe()
    {
        byte[] fixture = ReadFixture();
        Add("程序集载荷", fixture.Length > 0, $"读取 {fixture.Length:N0} 字节");

        ScriptDomain? domain = null;
        try
        {
            domain = new ScriptDomain(ScriptDomainKind.Metadata);
            Add("可回收脚本域", true, "成功创建 Metadata ScriptDomain");
            domain.LoadProjectAssembly(fixture);
            bool manifestOk = domain.Manifest.Scripts.Count == 1
                && domain.Manifest.Scripts[0].AssetHandle == 9001001;
            Add("动态程序集与清单", manifestOk,
                manifestOk ? domain.ManifestJson : "未读取到预期脚本清单");
        }
        catch (Exception exception)
        {
            Add("动态程序集与清单", false, $"{exception.GetType().Name}: {exception.Message}");
        }
        finally
        {
            try
            {
                domain?.BeginUnload();
                bool unloaded = domain is null;
                for (int attempt = 0; domain is not null && attempt < 100 && !unloaded; ++attempt)
                    unloaded = domain.PollUnload();
                Add("脚本域卸载", unloaded,
                    unloaded ? "域已卸载" : "域仍存活；浏览器可能不支持可回收 AssemblyLoadContext");
            }
            catch (Exception exception)
            {
                Add("脚本域卸载", false, $"{exception.GetType().Name}: {exception.Message}");
            }
        }

        ScriptDomain? playDomain = null;
        try
        {
            playDomain = new ScriptDomain(ScriptDomainKind.Play);
            playDomain.LoadProjectAssembly(fixture);
            ScriptSceneRuntime scene = playDomain.CreateSceneRuntime(1, 1);
            Entity entity = CreateEntity(1, 42, 1);
            scene.InstantiateAll([new ScriptAttachment(entity, 7001, 9001001, false)]);
            scene.InvokeCreateAll();

            Assembly assembly = GetLoadedAssembly(playDomain);
            Type behaviour = assembly.GetType("BrowserGame.BrowserProbeBehaviour", throwOnError: true)!;
            int creates = (int)(behaviour.GetField("Creates")?.GetValue(null) ?? -1);
            scene.DestroyAll();
            int destroys = (int)(behaviour.GetField("Destroys")?.GetValue(null) ?? -1);
            Add("脚本生命周期", creates == 1 && destroys == 1,
                $"OnCreate={creates}，OnDestroy={destroys}（禁用实例避免调用尚未接入的原生 API）");
        }
        catch (Exception exception)
        {
            Add("脚本生命周期", false, $"{exception.GetType().Name}: {exception.Message}");
        }
        finally
        {
            playDomain?.BeginUnload();
        }

        _passed = _results.Count >= 5 && _results.All(result => result.Passed);
        _running = false;
    }

    private static Entity CreateEntity(ulong sceneSessionId, ulong entityId, ulong generation) =>
        (Entity)(Activator.CreateInstance(typeof(Entity), BindingFlags.Instance | BindingFlags.NonPublic,
            binder: null, args: [sceneSessionId, entityId, generation], culture: null)
            ?? throw new InvalidOperationException("无法创建脚本实体句柄。"));

    private static Assembly GetLoadedAssembly(ScriptDomain domain) =>
        (Assembly)(typeof(ScriptDomain).GetField("_assembly", BindingFlags.Instance | BindingFlags.NonPublic)
            ?.GetValue(domain) ?? throw new InvalidOperationException("无法读取 Play 域程序集。"));

    private static byte[] ReadFixture()
    {
        using Stream stream = Assembly.GetExecutingAssembly().GetManifestResourceStream(
            "TomCat.BrowserScriptProbe.Assembly-CSharp.dll")
            ?? throw new InvalidOperationException("嵌入的 Assembly-CSharp.dll 不存在。");
        using var memory = new MemoryStream();
        stream.CopyTo(memory);
        return memory.ToArray();
    }

    private void Add(string name, bool passed, string detail) =>
        _results.Add(new ProbeResult(name, passed, detail));

    private sealed record ProbeResult(string Name, bool Passed, string Detail);
}
